# =============================================================================
# Anagu Web Portal — Local Environment Variables
# Copy this file to .env.local and fill in your Supabase project values.
# NEXT_PUBLIC_ prefixed values are safe for browser exposure.
# Never commit .env.local to version control.
# =============================================================================

# Supabase project URL (Settings > API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anon/public key — safe to use in browser clients
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Supabase service role key — server-side only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
