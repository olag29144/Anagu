{
  "name": "anagu",
  "version": "1.0.0",
  "description": "Anagu Land Administration Framework — permissioned full-stack land title system",
  "private": true,
  "scripts": {
    "dev": "NEXT_IGNORE_INCORRECT_LOCKFILE=1 npm run dev --workspace=@anagu/web",
    "build": "NEXT_IGNORE_INCORRECT_LOCKFILE=1 npm run build --workspace=@anagu/web",
    "start": "npm run start --workspace=@anagu/web",
    "lint": "npm run lint --workspace=@anagu/web",
    "test:mqtt": "npm --prefix backend run test:mqtt"
  },
  "workspaces": [
    "frontend/web"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "lodash": "^4.17.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  }
}
