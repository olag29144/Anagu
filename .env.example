# =============================================================================
# Anagu Land Administration Framework — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.
# =============================================================================

# --- Supabase ---
# Project URL from the Supabase dashboard (Settings > API)
SUPABASE_URL=https://<project-ref>.supabase.co

# Public anon key — safe to expose in browser clients
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Service role key — server-side only, never expose to clients
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# Database password used only by local PostgreSQL migration/test scripts
SUPABASE_DB_PASSWORD=<your-supabase-database-password>

# JWKS endpoint used by the NestJS JWT guard to verify Supabase-issued tokens
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Hyperledger Besu ---
# JSON-RPC HTTP endpoint for the local QBFT Besu node
BESU_RPC_URL=http://localhost:8545

# Private key of the Registrar wallet (used to sign mint transactions)
REGISTRAR_PRIVATE_KEY=<0x-prefixed-private-key>

# Private key of the Governor wallet (used to sign revocation transactions)
GOVERNOR_PRIVATE_KEY=<0x-prefixed-private-key>

# --- Deployed Contract Addresses ---
# Populated after running contracts/scripts/deploy.ts
LAND_TITLE_NFT_ADDRESS=<0x-deployed-contract-address>
LAND_REGISTRY_ADDRESS=<0x-deployed-contract-address>

# --- MQTT ---
# Connection URL for the EMQX MQTT broker
MQTT_BROKER_URL=mqtt://localhost:1883

# --- Redis ---
# Connection URL for the Redis instance
REDIS_URL=redis://localhost:6379
